{
  "name": "ORBITAL-GHG",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [3000, 8000],
  "portsAttributes": {
    "3000": { "label": "ORBITAL-GHG (globo)", "onAutoForward": "openPreview" },
    "8000": { "label": "API", "visibility": "public" }
  },
  "postCreateCommand": "cp -n .env.example .env || true",
  "postAttachCommand": "echo 'Para subir tudo: bash scripts/codespaces-start.sh'"
}
