# =============================================================================
# Produção (VPS) — copie para deploy/.env e preencha TUDO antes de subir.
# NUNCA reutilize os valores de desenvolvimento.
# =============================================================================

# domínios já apontando (DNS A) para o IP da VPS
APP_DOMAIN=app.suaempresa.com.br
API_DOMAIN=api.suaempresa.com.br

# identidade white-label
APP_NAME=ORBITAL-GHG

# segredos — gere com: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=
S3_ACCESS_KEY=orbital
S3_SECRET_KEY=

POSTGRES_DB=orbital
POSTGRES_USER=orbital

# alertas por e-mail (opcional; sem SMTP os alertas ficam só em /alerts)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@suaempresa.com.br

# integrações de dados (preencher quando tiver as credenciais)
CARBON_MAPPER_API_KEY=
GEE_SERVICE_ACCOUNT_EMAIL=
# caminho DENTRO do container; monte o arquivo via volume se for usar GEE
GEE_SERVICE_ACCOUNT_KEY_FILE=
