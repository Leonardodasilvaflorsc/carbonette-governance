# =============================================================================
# ORBITAL-GHG — variáveis de ambiente
# Copie para .env e preencha. Nenhuma chave é necessária para a FASE 0/1
# (o globo usa NASA GIBS, público e sem autenticação).
# =============================================================================

# --- Identidade do produto (white-label) ------------------------------------
NEXT_PUBLIC_APP_NAME=ORBITAL-GHG
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Banco de dados (TimescaleDB + PostGIS) ---------------------------------
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=orbital
POSTGRES_USER=orbital
POSTGRES_PASSWORD=orbital-dev-password
DATABASE_URL=postgresql://orbital:orbital-dev-password@db:5432/orbital

# --- Redis (broker Celery + cache) -------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Object storage S3-compatível (MinIO em dev) ----------------------------
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=orbital
S3_SECRET_KEY=orbital-dev-secret
S3_BUCKET_RASTERS=rasters
S3_BUCKET_REPORTS=reports

# --- Autenticação da plataforma (FASE 6) ------------------------------------
JWT_SECRET=troque-em-producao

# --- Copernicus Data Space Ecosystem (Sentinel-5P L2 — FASE 3+) -------------
# Registro gratuito: https://dataspace.copernicus.eu
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# --- Google Earth Engine (atalho do MVP quantitativo — FASE 3) --------------
# Service account com acesso ao GEE; JSON da chave em caminho montado no container
GEE_SERVICE_ACCOUNT_EMAIL=
GEE_SERVICE_ACCOUNT_KEY_FILE=

# --- Carbon Mapper (plumas de CH4 — FASE 4) ---------------------------------
# Registro gratuito: https://carbonmapper.org
CARBON_MAPPER_API_KEY=
# vento para inversão de fluxo: auto = ERA5 (Open-Meteo, sem chave) com
# fallback declarado para constante quando offline
WIND_PROVIDER=auto

# --- Copernicus Climate Data Store / ERA5 (vento p/ inversão — FASE 4) ------
# https://cds.climate.copernicus.eu
CDS_API_KEY=

# --- Climate TRACE / Atlas de Emissores (FASE 2) -----------------------------
# API pública, sem chave; URL configurável para fixar versão
CLIMATE_TRACE_API_URL=https://api.climatetrace.org/v6
# auto: PostGIS se alcançável, senão fixtures de demonstração em memória
FACILITY_BACKEND=auto
# países sincronizados pelo job de ingestão (ISO3, JSON array)
FACILITY_COUNTRIES=["BRA"]
FACILITY_REF_YEAR=2024

# --- SMTP (alertas por e-mail — FASE 6) --------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@example.com
